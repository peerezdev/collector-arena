DATABASE_URL=sqlite:///battlearena.db
CHAIN_SOURCE=mock          # mock | solana
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=
ELO_START=1200
ELO_K=32
SESSION_TTL=3600
CORS_ORIGINS=[]            # e.g. ["https://app.example.com","https://www.example.com"]
PRIVY_APP_ID=              # Privy App ID (público); sin él, /auth/privy/* responde 503
# PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/{app_id}/jwks.json  # override opcional
# PRIVY_APP_SECRET=        # SOLO Fase B (server-signing). NUNCA commitear. Rotar el expuesto.
# Operador: wallet servidora de Privy (owned by tu quorum) que financia el GAS del escrow en
# Pack Battle/Royale. SIN estas, las batallas se ANULAN al llenarse (no se siembra el escrow → reembolso).
# Crea la wallet servidora, fondéala con SOL de devnet, y pon aquí su wallet_id + dirección Solana.
PRIVY_OPERATOR_WALLET_ID=
PRIVY_OPERATOR_ADDRESS=
# Endpoints SOLO de desarrollo/test (p.ej. POST /pack-battles/{id}/join-bot, que mete un bot
# financiado en un lobby SIN auth y mueve USDC). DEJAR EN false EN PRODUCCIÓN.
DEV_ENDPOINTS_ENABLED=false
# Anti-drenaje de retiros (el operador paga gas + renta de la ATA destino de cada withdraw):
MIN_WITHDRAW_USDC=1.0          # retiro mínimo en USDC
WITHDRAW_RATE_LIMIT=5          # nº máx. de retiros por wallet y ventana
WITHDRAW_RATE_WINDOW_S=60      # ventana del rate-limit de retiros (segundos)
# Host público de metadata/imágenes de Collector Crypt por mint (keyless). El backend hace de
# proxy (browser→backend→CC) porque ese host NO envía cabeceras CORS. Cambiar a
# https://nft.collectorcrypt.com en mainnet.
CC_NFT_BASE_URL=https://nft-dev.collectorcrypt.com

# Launch week: solo estas wallets (Privy embedded Solana, coma-separadas) pueden CREAR Battle
# Royale. Vacío = abierto a todos. Debe coincidir con VITE_ROYALE_CREATOR_ALLOWLIST del frontend.
ROYALE_CREATOR_ALLOWLIST=

# Acceso PERMANENTE al Machine Tracker, sin la puerta de los 100 USDC apostados. Solo cuentas de
# la casa: probar el tracker no puede exigir apostar de verdad cada semana. La wallet sale del
# token de Privy verificado, así que estar aquí NO se puede suplantar.
TRACKER_ACCESS_ALLOWLIST=

# El pase de PAGO del Machine Tracker, la vía alternativa a apostar los 100 USDC.
#
# CERO APAGA LA COMPRA ENTERA, igual que un GACHA_BASE_URL vacío apaga el gacha: la opción no
# aparece en pantalla y el endpoint responde 503. Por eso esto se puede desplegar antes de haber
# decidido el precio, que es el estado en el que sale de fábrica.
#
# El de 30 días debería salir MÁS BARATO por día que el de 7. Si no, el backend lo avisa al
# arrancar: es un error de configuración que si no, solo lo descubre el cliente que eche la cuenta.
TRACKER_PASS_7D_USDC=0
TRACKER_PASS_30D_USDC=0
# Freno de compras por wallet: mueve dinero real, igual que los retiros y las propinas.
TRACKER_PASS_RATE_LIMIT=5        # nº máx. de compras por wallet y ventana
TRACKER_PASS_RATE_WINDOW_S=60    # ventana del freno (segundos)

# Propinas en USDC entre jugadores. APAGADAS por defecto; con esto en false el endpoint
# /users/me/tip responde 503 y no se toca ni la base ni la cadena. Apagarlas NO borra nada: las
# propinas ya hechas siguen en la tabla `tips`. Debe coincidir con VITE_TIPS_ENABLED del frontend.
TIPS_ENABLED=false
